{
  "name": "vue-asset-map",
  "version": "1.2.0",
  "description": "Interactive infrastructure asset map for Vue 3, built on Vue Flow",
  "keywords": [
    "vue",
    "vue3",
    "vue-flow",
    "network-map",
    "topology",
    "asset-map",
    "infrastructure",
    "graph",
    "visualization",
    "typescript"
  ],
  "license": "MIT",
  "author": "Dmitriy Korolev <diptimus@gmail.com>",
  "homepage": "https://LegionLiner.github.io/vue-asset-map/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/LegionLiner/vue-asset-map.git"
  },
  "bugs": {
    "url": "https://github.com/LegionLiner/vue-asset-map/issues"
  },
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./layout-dagre": {
      "types": "./dist/layout/dagre.d.ts",
      "import": "./dist/layout/dagre.js"
    },
    "./layout-worker": {
      "types": "./dist/layout/worker.d.ts",
      "import": "./dist/layout/worker.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "vue-tsc --build --force",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write \"**/*.{ts,vue,css,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,vue,css,json,md}\"",
    "dev": "vite --config playground/vite.config.ts",
    "build:playground": "vite build --config playground/vite.config.ts",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "verify:dist": "node scripts/verify-dist.mjs",
    "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run verify:dist"
  },
  "peerDependencies": {
    "@vue-flow/core": "^1.42.0",
    "vue": "^3.4.0"
  },
  "optionalDependencies": {
    "@dagrejs/dagre": "^1.1.0"
  },
  "devDependencies": {
    "@dagrejs/dagre": "^1.1.4",
    "@types/node": "^22.9.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vitest/coverage-v8": "^2.1.5",
    "@vue-flow/core": "^1.42.0",
    "@vue/eslint-config-typescript": "^14.1.3",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "jsdom": "^25.0.1",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vite-plugin-dts": "^4.3.0",
    "vitepress": "^1.5.0",
    "vitest": "^2.1.5",
    "vue": "^3.5.12",
    "vue-tsc": "^2.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "vue-demi"
    ]
  }
}

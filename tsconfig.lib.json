{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    // `node` нужен guard-тестам, которые читают исходники с диска: содержимое
    // CSS через бандлер получить нельзя (Vitest отключает обработку CSS).
    // Отсутствие node-глобалей в `src/` теперь проверяет не tsconfig, а
    // явный тест `tests/guards/purity.test.ts` — см. D-301 в DECISIONS.md.
    "types": ["vite/client", "node"],

    "strict": true,
    "noImplicitOverride": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // Алиасы нужны только плейграунду: он импортирует библиотеку так же, как
    // это будет делать потребитель — по имени пакета, а не по относительному пути.
    "baseUrl": ".",
    "paths": {
      "vue-asset-map": ["./src/index.ts"],
      "@fixtures/*": ["./fixtures/*"]
    },

    "noEmit": true,
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.lib.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "fixtures/**/*.ts",
    "tests/**/*.ts",
    "playground/**/*.ts",
    "playground/**/*.vue"
  ]
}
